import hashlib, struct, binascii
from Crypto.Random import get_random_bytes

# ----- Simple Feistel Block Cipher -----
class SimpleFeistelBlockCipher:
    def __init__(self, key: bytes, rounds: int = 8):
        self.key = key
        self.rounds = rounds
        self.round_keys = self._derive_round_keys()

    def _derive_round_keys(self):
        round_keys = []
        data = self.key
        for i in range(self.rounds):
            h = hashlib.sha256(data + bytes([i])).digest()
            round_keys.append(struct.unpack(">I", h[:4])[0])
            data = h
        return round_keys

    def _F(self, half, round_key):
        x = (half << 5 | half >> 27) & 0xFFFFFFFF
        x = (x ^ round_key) & 0xFFFFFFFF
        return ((x * 0x9E3779B1) + 0x7F4A7C15) & 0xFFFFFFFF

    def encrypt_block(self, block):
        L, R = struct.unpack(">II", block)
        for k in self.round_keys:
            L, R = R, L ^ self._F(R, k)
        return struct.pack(">II", L, R)

    def decrypt_block(self, block):
        L, R = struct.unpack(">II", block)
        for k in reversed(self.round_keys):
            L, R = R ^ self._F(L, k), L
        return struct.pack(">II", L, R)

# ----- Padding -----
def pad(data, block_size=8):
    pad_len = block_size - (len(data) % block_size)
    return data + bytes([pad_len]) * pad_len

def unpad(data):
    return data[:-data[-1]]
